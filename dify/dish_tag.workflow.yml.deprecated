# 菜品维度打标工作流（Dify 1.6.0 DSL）
#
# 本文件是【设计稿】：结构按 Dify 1.6.0 的导出格式书写，但尚未经过一次
# 「导入控制台 → 再导出 → diff」的往返验证。首次导入后若 Dify 重排了键序、
# 补齐了默认字段或改写了节点 id，以【导出物】为准回写本文件，
# 并同步开发方案 §13.2.1 的字段路径表。
#
# 拓扑被 R56 锁死为 开始 → LLM → 结束 三个节点，不得新增代码节点、
# 模板转换节点、条件分支或变量赋值节点。
app:
  description: 单维度 × 单批次（≤40 道）菜品打标，输出 REJECT / UNKNOWN / NEUTRAL 三态。输入只含公开菜品数据，不含任何用户或健康数据。
  icon: 🍱
  icon_background: '#FFEAD5'
  mode: workflow
  name: dish-tag
  use_icon_as_answer_icon: false
dependencies:
- current_identifier: null
  type: marketplace
  value:
    marketplace_plugin_unique_identifier: langgenius/openai_api_compatible:0.0.1
kind: app
version: 0.3.0
workflow:
  conversation_variables: []
  environment_variables:
  # D3：这两个值进菜品 tagHash，版本不同步是全案唯一完全静默的失败模式。
  # 放在环境变量里是为了能被 DSL 导出捕获；写在节点备注里解析不稳定。
  - description: 提示词版本，必须与 PromptVersions.DISH_TAG 及 prompt/dish_tag.md 头部一致
    id: 8b2f4c10-0000-4000-8000-000000000001
    name: promptVersion
    selector:
    - env
    - promptVersion
    value: dishtag-2.2.1
    value_type: string
  - description: 模型版本，必须与 llm.model-version-dishtag 配置项及本工作流 LLM 节点的 model.name 一致
    id: 8b2f4c10-0000-4000-8000-000000000002
    name: modelVersion
    selector:
    - env
    - modelVersion
    value: PLACEHOLDER_DISHTAG_MODEL
    value_type: string
  features:
    file_upload:
      enabled: false
    opening_statement: ''
    retriever_resource:
      enabled: false
    sensitive_word_avoidance:
      enabled: false
    speech_to_text:
      enabled: false
    suggested_questions: []
    suggested_questions_after_answer:
      enabled: false
    text_to_speech:
      enabled: false
  graph:
    edges:
    - data:
        sourceType: start
        targetType: llm
      id: start-llm
      source: start
      sourceHandle: source
      target: llm
      targetHandle: target
      type: custom
    - data:
        sourceType: llm
        targetType: end
      id: llm-end
      source: llm
      sourceHandle: source
      target: end
      targetHandle: target
      type: custom
    nodes:
    - data:
        desc: 三个输入全部由 Java 组装；工作流不读库、不拼接、不补默认值。
        title: 开始
        type: start
        variables:
        # D1 选定方案 a：提示词正文不进 DSL，由 Java 每次调用传入，
        # 真源只有 prompt/dish_tag.md 一份，改提示词不必重新导出 DSL。
        - label: systemPrompt
          max_length: 48000
          options: []
          required: true
          type: paragraph
          variable: systemPrompt
        # Java 按 prompt/dish_tag.md「User（每批填充）」小节渲染好的批次正文。
        # 渲染放在 Java 而不是模板转换节点，是因为 R56 不允许出现模板节点，
        # 且字符串拼接是可穷举输入的确定性操作，本就不该交给模型侧。
        - label: userMessage
          max_length: 48000
          options: []
          required: true
          type: paragraph
          variable: userMessage
        # 仅用于把维度回填进输出与排障；判断逻辑不依赖它。
        - label: enumKey
          max_length: 32
          options: []
          required: true
          type: text-input
          variable: enumKey
      height: 116
      id: start
      position:
        x: 80
        y: 282
      positionAbsolute:
        x: 80
        y: 282
      selected: false
      sourcePosition: right
      targetPosition: left
      type: custom
      width: 244
    - data:
        context:
          enabled: false
          variable_selector: []
        desc: 唯一的模型节点。无后处理、无兜底、无重试。
        model:
          completion_params:
            # 打标要可复现：同一批输入必须得到同一批标签，否则 tagHash 复用会自相矛盾。
            temperature: 0
            max_tokens: 8192
          mode: chat
          name: PLACEHOLDER_DISHTAG_MODEL
          provider: langgenius/openai_api_compatible/openai_api_compatible
        prompt_template:
        - id: system-prompt
          role: system
          text: '{{#start.systemPrompt#}}'
        - id: user-prompt
          role: user
          text: '{{#start.userMessage#}}'
        # D6：全案零重试。模型侧重试会让「一次调用」变成隐藏的多次调用，
        # 既打乱配额核算，也让失败批次的作废语义失效。
        retry_config:
          max_retries: 0
          retry_enabled: false
          retry_interval: 0
        # 出错即向上抛，不走默认值分支——分支节点也会被 R56 判失败。
        error_strategy: null
        # D2：输出契约。这里只能放 schema/dish_tag_output.schema.json 中
        # 结构化输出能表达的子集（类型、必填、枚举、additionalProperties）。
        # allOf/if/then 那两条条件约束（INGREDIENT 必须带 matchedIngredients、
        # DISH_NAME/COOKING 必须带 reason）结构化输出表达不了，
        # 留在提示词「输出规则」小节 + DishTagContractValidator 里兜底。
        structured_output_enabled: true
        structured_output:
          schema:
            additionalProperties: false
            properties:
              enumKey:
                enum:
                - SHRIMP_CRAB
                - FISH
                - MILK
                - EGG
                - PEANUT
                - SOY
                - WHEAT
                - NUTS
                - MANGO
                - BEEF
                - MUTTON
                - LOW_FAT
                - LOW_SODIUM
                - LOW_ADDED_SUGAR
                - LOW_PURINE
                - LOW_CHOLESTEROL
                - LOW_CALORIE
                - HIGH_FIBER
                - LIMIT_ALCOHOL
                - LIGHT_DIET
                type: string
              hitList:
                items:
                  additionalProperties: false
                  properties:
                    dishId:
                      minimum: 1
                      type: integer
                    evidenceType:
                      enum:
                      - INGREDIENT
                      - DISH_NAME
                      - COOKING
                      type: string
                    matchedIngredients:
                      items:
                        maxLength: 32
                        minLength: 1
                        type: string
                      maxItems: 10
                      type: array
                      uniqueItems: true
                    reason:
                      maxLength: 128
                      type: string
                    verdict:
                      enum:
                      - REJECT
                      type: string
                  required:
                  - dishId
                  - verdict
                  - evidenceType
                  - matchedIngredients
                  - reason
                  type: object
                maxItems: 40
                type: array
              neutralDishIds:
                items:
                  minimum: 1
                  type: integer
                maxItems: 40
                type: array
                uniqueItems: true
              unknownDishIds:
                items:
                  minimum: 1
                  type: integer
                maxItems: 40
                type: array
                uniqueItems: true
            required:
            - enumKey
            - neutralDishIds
            - unknownDishIds
            - hitList
            type: object
        title: 打标
        type: llm
        vision:
          enabled: false
      height: 98
      id: llm
      position:
        x: 384
        y: 282
      positionAbsolute:
        x: 384
        y: 282
      selected: false
      sourcePosition: right
      targetPosition: left
      type: custom
      width: 244
    - data:
        desc: 两个版本号随结果一起回传，供 Java 在写库前做运行时对齐断言。
        outputs:
        - value_selector:
          - llm
          - structured_output
          variable: result
        - value_selector:
          - env
          - promptVersion
          variable: promptVersion
        - value_selector:
          - env
          - modelVersion
          variable: modelVersion
        title: 结束
        type: end
      height: 116
      id: end
      position:
        x: 688
        y: 282
      positionAbsolute:
        x: 688
        y: 282
      selected: false
      sourcePosition: right
      targetPosition: left
      type: custom
      width: 244
