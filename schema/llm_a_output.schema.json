{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-report/schema/llm_a_output.schema.json",
  "title": "LLM-A 体检报告结构化抽取输出",
  "description": "对应开发方案 §7.3。模型只负责【识别到的内容 + 它属于哪些 segment / 哪个章节】，不生成任何全局序号，也不做版面拼行——解析器只给原子块与坐标，版面关系由模型看图判断，Java 只做字符串包含与排序。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batchStatus",
    "patient",
    "reportOverview",
    "sectionTitleSegmentIds",
    "allergenSectionSegmentIds",
    "indicators",
    "textualFindings",
    "summaryConclusions",
    "allergens",
    "nutritionSupplements",
    "dietRequirements"
  ],
  "properties": {
    "batchStatus": {
      "type": "string",
      "enum": [
        "OK",
        "NO_REPORT_FEATURE",
        "UNREADABLE"
      ],
      "description": "NO_REPORT_FEATURE=读得清但无体检报告特征；UNREADABLE=读不清。两者不可互换（§4.1.1）"
    },
    "patient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "gender"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "gender": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "男",
            "女",
            null
          ]
        }
      }
    },
    "reportOverview": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "totalCount",
        "abnormalCount"
      ],
      "description": "报告自带的汇总数字。报告没印就返回 null，不许自己算。",
      "properties": {
        "totalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "abnormalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        }
      }
    },
    "indicators": {
      "type": "array",
      "maxItems": 500,
      "description": "有数值 + 有结论。正常项也必须提（§4.3-2）。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit",
          "refRange",
          "conclusionText",
          "status",
          "statusJudgedByModel",
          "itemIndex",
          "segmentIds",
          "sectionSegmentId"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32
          },
          "refRange": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "conclusionText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "status": {
            "$ref": "#/$defs/indicatorStatus"
          },
          "statusJudgedByModel": {
            "type": "boolean"
          },
          "itemIndex": {
            "$ref": "#/$defs/itemIndex"
          },
          "segmentIds": {
            "$ref": "#/$defs/segmentIds"
          },
          "sectionSegmentId": {
            "$ref": "#/$defs/sectionSegmentId"
          }
        }
      }
    },
    "textualFindings": {
      "type": "array",
      "maxItems": 200,
      "description": "无数值 + 有结论。含正常项（如「肝胆B超：未见明显异常」），靠 status 区分。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "conclusionText",
          "status",
          "includeInHealthProblems",
          "itemIndex",
          "segmentIds",
          "sectionSegmentId"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "conclusionText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "status": {
            "type": "string",
            "enum": [
              "NORMAL",
              "ABNORMAL"
            ]
          },
          "includeInHealthProblems": {
            "type": "boolean"
          },
          "itemIndex": {
            "$ref": "#/$defs/itemIndex"
          },
          "segmentIds": {
            "$ref": "#/$defs/segmentIds"
          },
          "sectionSegmentId": {
            "$ref": "#/$defs/sectionSegmentId"
          }
        }
      }
    },
    "summaryConclusions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemNo",
          "categories",
          "includeInHealthProblems",
          "itemIndex",
          "segmentIds",
          "sectionSegmentId"
        ],
        "properties": {
          "itemNo": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 999,
            "description": "报告原文编号，无编号则 null，仅用于来源标注文案"
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/summaryCategory"
            }
          },
          "includeInHealthProblems": {
            "type": "boolean"
          },
          "itemIndex": {
            "$ref": "#/$defs/itemIndex"
          },
          "segmentIds": {
            "$ref": "#/$defs/segmentIds"
          },
          "sectionSegmentId": {
            "$ref": "#/$defs/sectionSegmentId"
          }
        }
      }
    },
    "allergens": {
      "type": "array",
      "maxItems": 100,
      "description": "筛查表全部项目都要列出，含阴性。省略阴性会让 Java 无法核对是否漏抽阳性（§4.3-9）。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enumKey",
          "isFoodBorne",
          "rawName",
          "rawResult",
          "resultStatus",
          "itemIndex",
          "segmentIds",
          "sectionSegmentId"
        ],
        "properties": {
          "enumKey": {
            "$ref": "#/$defs/allergenKey"
          },
          "isFoodBorne": {
            "type": "boolean"
          },
          "rawName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "rawResult": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "resultStatus": {
            "type": "string",
            "enum": [
              "POSITIVE",
              "NEGATIVE",
              "BORDERLINE",
              "UNKNOWN"
            ]
          },
          "itemIndex": {
            "$ref": "#/$defs/itemIndex"
          },
          "segmentIds": {
            "$ref": "#/$defs/segmentIds"
          },
          "sectionSegmentId": {
            "$ref": "#/$defs/sectionSegmentId"
          }
        }
      }
    },
    "nutritionSupplements": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/nutritionSupplementItem"
      }
    },
    "dietRequirements": {
      "type": "array",
      "maxItems": 50,
      "description": "一条原文含多个要求时拆多条，共享同一 segmentId，各自给不同的 itemIndex（§7.3）。",
      "items": {
        "$ref": "#/$defs/dietRequirementItem"
      }
    },
    "sectionTitleSegmentIds": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/segmentId"
      },
      "description": "被识别为章节标题的 segment。模型不返回章节序号——并行分批下它无法知道前面批次识别了多少章节。Java 按文件内 seq 升序把标题之间的区间划成章节。"
    },
    "allergenSectionSegmentIds": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/segmentId"
      },
      "description": "过敏筛查章节的【全部】segment，包括未能抽出条目的数据行。这是过敏漏抽覆盖检查的输入，漏圈等于关掉最后一道防线。无过敏章节时为空数组。"
    }
  },
  "$defs": {
    "segmentId": {
      "type": "string",
      "pattern": "^f[0-9]{1,2}-p[0-9]{1,4}-s[0-9]{1,5}$",
      "description": "后端预分配，模型只能原样返回，不得自行构造（§3.2.1）"
    },
    "fileIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "indicatorStatus": {
      "type": "string",
      "enum": [
        "NORMAL",
        "HIGH",
        "LOW",
        "ABNORMAL"
      ]
    },
    "summaryCategory": {
      "type": "string",
      "enum": [
        "HEALTH_PROBLEM",
        "DIET_ADVICE",
        "LIFESTYLE",
        "ROUTINE",
        "NORMAL_STATEMENT"
      ]
    },
    "allergenKey": {
      "type": "string",
      "enum": [
        "SHRIMP_CRAB",
        "FISH",
        "MILK",
        "EGG",
        "PEANUT",
        "SOY",
        "WHEAT",
        "NUTS",
        "MANGO",
        "BEEF",
        "MUTTON",
        "DUST_MITE",
        "POLLEN",
        "ANIMAL_DANDER",
        "MOLD",
        "COCKROACH",
        "OTHER"
      ],
      "description": "食入性 11 组源自 allergen_display_split.csv（数据真源）；非食物 5 组只展示不参与菜品匹配。表里没有的一律 OTHER。"
    },
    "nutritionKey": {
      "type": "string",
      "enum": [
        "IRON",
        "CALCIUM",
        "PROTEIN",
        "VITAMIN_D",
        "VITAMIN_B12",
        "FOLATE",
        "DIETARY_FIBER",
        "ZINC",
        "POTASSIUM",
        "OTHER"
      ]
    },
    "dietRequirementKey": {
      "type": "string",
      "enum": [
        "LOW_FAT",
        "LOW_SODIUM",
        "LOW_ADDED_SUGAR",
        "LOW_PURINE",
        "LOW_CHOLESTEROL",
        "LOW_CALORIE",
        "HIGH_FIBER",
        "LIMIT_ALCOHOL",
        "LIGHT_DIET",
        "OTHER"
      ]
    },
    "itemIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99,
      "description": "同一 segment 内第几个条目，0 起。segmentId + itemIndex 构成稳定条目标识，用于去重。"
    },
    "nutritionSupplementItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enumKey",
        "itemIndex",
        "segmentIds",
        "sectionSegmentId"
      ],
      "properties": {
        "enumKey": {
          "$ref": "#/$defs/nutritionKey"
        },
        "itemIndex": {
          "$ref": "#/$defs/itemIndex"
        },
        "segmentIds": {
          "$ref": "#/$defs/segmentIds"
        },
        "sectionSegmentId": {
          "$ref": "#/$defs/sectionSegmentId"
        }
      }
    },
    "dietRequirementItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enumKey",
        "itemIndex",
        "segmentIds",
        "sectionSegmentId"
      ],
      "properties": {
        "enumKey": {
          "$ref": "#/$defs/dietRequirementKey"
        },
        "itemIndex": {
          "$ref": "#/$defs/itemIndex"
        },
        "segmentIds": {
          "$ref": "#/$defs/segmentIds"
        },
        "sectionSegmentId": {
          "$ref": "#/$defs/sectionSegmentId"
        }
      }
    },
    "segmentIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/segmentId"
      },
      "description": "该条目引用的全部 segment。字段分散在多个块时一起引用；Java 把它们合并后再做包含性校验（§6.3.2）。"
    },
    "sectionSegmentId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^f[0-9]{1,2}-p[0-9]{1,4}-s[0-9]{1,5}$",
      "description": "该条目所属章节标题的 segmentId。由模型标注，Java 不自己划区间。无所属章节时为 null。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "batchStatus": {
            "not": {
              "const": "OK"
            }
          }
        },
        "required": [
          "batchStatus"
        ]
      },
      "then": {
        "properties": {
          "sectionTitleSegmentIds": {
            "maxItems": 0
          },
          "indicators": {
            "maxItems": 0
          },
          "textualFindings": {
            "maxItems": 0
          },
          "summaryConclusions": {
            "maxItems": 0
          },
          "allergens": {
            "maxItems": 0
          },
          "nutritionSupplements": {
            "maxItems": 0
          },
          "dietRequirements": {
            "maxItems": 0
          },
          "reportOverview": {
            "type": "null"
          },
          "allergenSectionSegmentIds": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}