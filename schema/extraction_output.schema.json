                    "maxItems": 0
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "$comment": "指标结论来源的四条联动约束。REPORT_TEXT 走报告原文，REFERENCE_RANGE_IN_RANGE 走参考范围准入，两者不得并存——并存等于同一条指标有两套结论。",
      "properties": {
        "indicators": {
          "items": {
            "allOf": [
              {
                "$comment": "① REPORT_TEXT：必须有结论原文，且不得携带比较条件。",
                "if": {
                  "properties": {
                    "conclusionBasis": {
                      "const": "REPORT_TEXT"
                    }
                  },
                  "required": [
                    "conclusionBasis"
                  ]
                },
                "then": {
                  "properties": {
                    "conclusionText": {
                      "type": "string"
                    },
                    "rangeComparison": {
                      "type": "null"
                    },
                    "valueMatch": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "$comment": "② REFERENCE_RANGE_IN_RANGE：报告没印结论，必须给参考范围与比较条件；结论只可能是正常，因此 status 固定 NORMAL、不进健康问题。",
                "if": {
                  "properties": {
                    "conclusionBasis": {
                      "const": "REFERENCE_RANGE_IN_RANGE"
                    }
                  },
                  "required": [
                    "conclusionBasis"
                  ]
                },
                "then": {
                  "properties": {
                    "conclusionText": {
                      "type": "null"
                    },
                    "refRange": {
                      "type": "string"
                    },
                    "rangeComparison": {
                      "type": "object"
                    },
                    "valueMatch": {
                      "type": "null"
                    },
                    "status": {
                      "const": "NORMAL"
                    },
                    "includeInHealthProblems": {
                      "const": false
                    },
                    "problemName": {
                      "type": "null"
                    }
                  }
                }
              }
              ,
