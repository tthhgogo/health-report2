                  ]
                },
                "then": {
                  "properties": {
                    "conclusionText": {
                      "type": "null"
                    },
                    "refRange": {
                      "type": "string"
                    },
                    "valueMatch": {
                      "type": "object"
                    },
                    "rangeComparison": {
                      "type": "null"
                    },
                    "status": {
                      "const": "NORMAL"
                    },
