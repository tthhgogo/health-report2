{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-report/schema/extraction_output.schema.json",
  "title": "体检报告结构化抽取输出",
  "description": "体检报告抽取的批次输出。模型负责【识别到的内容 + 它属于哪些块 + 它属于哪个章节】；解析器只给原子块与坐标，版面关系由模型看图判断，Java 只做字符串包含与排序。定位一律用【批内块号 blockRef】（输入里标在每块前面的 [n]），不是 segmentId——后端收到响应后查映射表展开，模型看不到也用不着 segmentId。章节归属【由模型返回】——sections 数组 + 逐条目 sectionIndex。sectionIndex 是【批内局部序号】，模型不生成全局序号；跨批对齐靠 sections[].sectionBlockRef 展开后的 segmentId。Java 不得从扁平序列反推章节归属。一个批次的全部页必须来自同一个文件。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fileIndex",
    "batchIndex",
    "batchCount",
    "batchStatus",
    "patient",
    "reportOverview",
    "sections",
    "allergenSectionBlockRefs",
    "allergenDataBlockRefs",
    "indicators",
    "textualFindings",
    "summaryConclusions",
    "allergens",
    "nutritionSupplements",
    "dietRequirements"
  ],
  "properties": {
    "fileIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "description": "本批所属文件下标，原样回填输入值。批次不跨文件，Java 断言与请求一致，不一致则整任务失败。"
    },
    "batchIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7,
      "description": "本批序号，原样回填输入值。"
    },
    "batchCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "本任务总批数，原样回填输入值。上限 8（5 文件各自向上取整）。"
    },
    "batchStatus": {
      "type": "string",
      "enum": [
        "OK",
        "NO_REPORT_FEATURE",
        "UNREADABLE"
      ],
      "description": "NO_REPORT_FEATURE=读得清但无体检报告特征；UNREADABLE=读不清。两者不可互换"
    },
    "patient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "nameBlockRefs",
        "gender",
        "genderBlockRefs"
      ],
      "description": "仅用于跨批同一性校验，用完即丢、从不展示。但【不展示不是免校验理由】——姓名性别能把整个任务判成 IDENTITY_MISMATCH，所以与展示字段用同一套来源约束。非空值必须带证据数组并通过包含性校验，校验不过的字段降为 null 且不参与冲突判断。",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 32
        },
        "nameBlockRefs": {
          "$ref": "#/$defs/evidenceBlockRefs",
          "description": "印着姓名的那些段。name 为 null 时必须是空数组，非 null 时至少一个元素。"
        },
        "gender": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "男",
            "女",
            null
          ]
        },
        "genderBlockRefs": {
          "$ref": "#/$defs/evidenceBlockRefs",
          "description": "印着性别的那些段。规则同 nameBlockRefs。"
        }
      }
    },
    "reportOverview": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "totalCount",
        "abnormalCount",
        "blockRefs"
      ],
      "description": "报告自带的汇总数字。报告没印就返回 null，不许自己算。必须给 blockRefs，指向印着这行字的那些块。Java 会核对【两个十进制数字都真的出现在这些块里】，不只是核对 blockRefs 非空——给了个不相干的段同样不算证据；核对不过整个 reportOverview 降为 null，回退到本模块卡片计数。",
      "properties": {
        "totalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "abnormalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "blockRefs": {
          "$ref": "#/$defs/blockRefs"
        }
      }
    },
    "indicators": {
      "type": "array",
      "maxItems": 500,
      "description": "有数值 + 有结论。正常项也必须提。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit",
          "refRange",
          "conclusionText",
          "conclusionBasis",
          "rangeComparison",
          "valueMatch",
          "status",
          "includeInHealthProblems",
          "problemName",
          "sectionIndex",
          "orderInSection",
          "itemIndex",
          "blockRefs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 32
          },
          "refRange": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 64,
            "description": "参考范围原文，必须逐字来自报告且非空。【没印参考范围就给 null，不许给空串】——空串能通过一切子串式核验，等于让该指标绕过来源回切。"
          },
          "conclusionText": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 64,
            "description": "报告为该指标印出的结论原文（「↑偏高」「未见异常」）。【报告没印结论时必须给 null，不许自己编一个「正常」填进来】——本字段的语义就是「报告上的原话」，编进来的字会被当成原文展示给用户。为 null 时必须给出 refRange 与 rangeComparison，走 REFERENCE_RANGE_IN_RANGE 准入。"
          },
          "conclusionBasis": {
            "$ref": "#/$defs/conclusionBasis"
          },
          "rangeComparison": {
            "oneOf": [
              {
                "$ref": "#/$defs/rangeComparison"
              },
              {
                "type": "null"
              }
            ],
            "description": "把参考范围拆成可直接比较的十进制上下界。【哪个参考范围适用、单位是否对齐、性别年龄方法学怎么选，全部由模型判断】；Java 会把 refRange 原文解析一遍，要求这里拆出的下界、上界与两侧开闭与原文里写着的某一个区间完全一致，对不上整条丢弃——只核验单个边界拦不住「省略一侧」「拿子串当边界」「篡改开闭」三种绕过。拆不出唯一比较条件（多套人群范围无法确认适用、单位不一致、值非十进制）时必须给 null，该指标随之不展示——不许猜。"
          },
          "valueMatch": {
            "oneOf": [
              {
                "$ref": "#/$defs/valueMatch"
              },
              {
                "type": "null"
              }
            ],
            "description": "定性项目的配对结果。报告只印了定性结果与定性参考值（如「亚硝酸盐 阴性 / 参考值 阴性」）时给出。【归一化是你的活】：把「阴性」「(-)」「未见」这类写法统一到同一个枚举；Java 只对归一化后的两个枚举做 equals，绝不判断「阴性」与「未检出」是不是一回事。归不进枚举、或两侧不是同一类可比值时给 null，该指标随之不展示。"
          },
          "status": {
            "$ref": "#/$defs/indicatorStatus"
          },
          "includeInHealthProblems": {
            "type": "boolean",
            "description": "健康问题模块准入，由模型判定。【不是 status != NORMAL 的同义词】：临界偏离而报告未作提示的可判 false，数值正常但报告写了提示的可判 true。Java 不得从 status 反推。"
          },
          "problemName": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 64,
            "description": "健康问题模块展示名，只能是报告原文里的自然语言问题表述（「甘油三酯偏高」），且必须能在本条目 blockRefs 所指的块里找到。报告只有指标名加符号、没有成句表述时【必须给 null】，由 Java 拼 name + conclusionText 两段原文——不许模型自造说法，也不许 Java 补归一化结论词。"
          },
          "sectionIndex": {
            "$ref": "#/$defs/sectionIndex"
          },
          "orderInSection": {
            "$ref": "#/$defs/orderInSection"
          },
          "itemIndex": {
            "$ref": "#/$defs/itemIndex"
          },
          "blockRefs": {
            "$ref": "#/$defs/blockRefs"
          }
        }
      }
    },
    "textualFindings": {
      "type": "array",
      "maxItems": 200,
      "description": "无数值 + 有结论。含正常项（如「肝胆B超：未见明显异常」），靠 status 区分。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "conclusionText",
          "status",
          "includeInHealthProblems",
          "sectionIndex",
          "orderInSection",
          "itemIndex",
          "blockRefs"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "conclusionText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "status": {
            "type": "string",
            "enum": [
              "NORMAL",
              "ABNORMAL"
            ]
          },
          "includeInHealthProblems": {
            "type": "boolean",
            "description": "status=NORMAL 的条目必须为 false。Java 【不做任何检查】——既不覆写也不扫词表告警，准入判定权完全在模型。"
          },
          "sectionIndex": {
            "$ref": "#/$defs/sectionIndex"
          },
          "orderInSection": {
            "$ref": "#/$defs/orderInSection"
          },
          "itemIndex": {
            "$ref": "#/$defs/itemIndex"
          },
          "blockRefs": {
            "$ref": "#/$defs/paragraphBlockRefs"
          }
        }
      }
    },
    "summaryConclusions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceOrder",
          "itemNo",
          "categories",
          "includeInHealthProblems",
          "sectionIndex",
          "itemIndex",
          "blockRefs"
        ],
        "properties": {
          "sourceOrder": {
            "$ref": "#/$defs/sourceOrder"
          },
          "itemNo": {
            "$ref": "#/$defs/itemNo"
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/summaryCategory"
            }
          },
          "includeInHealthProblems": {
            "type": "boolean",
            "description": "只有 categories 含 HEALTH_PROBLEM 或 DIET_ADVICE 时才可为 true。Java 不覆写、也不扫词表告警。"
          },
          "sectionIndex": {
            "$ref": "#/$defs/sectionIndex"
          },
          "itemIndex": {
            "$ref": "#/$defs/itemIndex"
          },
          "blockRefs": {
            "$ref": "#/$defs/paragraphBlockRefs"
          }
        }
      }
    },
    "allergens": {
      "type": "array",
      "maxItems": 100,
      "description": "筛查表全部项目都要列出，含阴性。省略阴性会让 Java 无法核对是否漏抽阳性。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enumKey",
          "isFoodBorne",
          "rawName",
          "rawResult",
          "resultStatus",
          "sectionIndex",
          "sourceOrder",
          "itemIndex",
          "blockRefs"
        ],
        "properties": {
          "enumKey": {
            "$ref": "#/$defs/allergenKey"
          },
          "isFoodBorne": {
            "type": "boolean",
            "description": "正式枚举（13 食入性 + 5 非食物）的该属性由 Java 查 AllergenGroups 常量表得出，模型返回值直接丢弃、不比对不计数；只有 enumKey=OTHER 时采信模型。Java 词表不得把 true 改成 false——那会关掉菜品拦截。"
          },
          "rawName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "rawResult": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "resultStatus": {
            "description": "仅转写报告结果状态，不作临床诊断。BORDERLINE 表示报告写弱阳性、可疑、临界或±；后端会将其作为保守安全信号处理。",
            "type": "string",
            "enum": [
              "POSITIVE",
              "NEGATIVE",
              "BORDERLINE",
              "UNKNOWN"
            ]
          },
          "sectionIndex": {
            "$ref": "#/$defs/sectionIndex"
          },
          "sourceOrder": {
            "$ref": "#/$defs/sourceOrder"
          },
          "itemIndex": {
            "$ref": "#/$defs/itemIndex"
          },
          "blockRefs": {
            "$ref": "#/$defs/blockRefs"
          }
        }
      }
    },
    "nutritionSupplements": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/nutritionSupplementItem"
      }
    },
    "dietRequirements": {
      "type": "array",
      "maxItems": 50,
      "description": "一条原文含多个要求时拆多条，共享同一块，各自给不同的 itemIndex。",
      "items": {
        "$ref": "#/$defs/dietRequirementItem"
      }
    },
    "sections": {
      "type": "array",
      "maxItems": 200,
      "description": "本批出现的章节。sectionIndex 是批内局部序号，每批从 0 起；跨批的同一章节【不会两批返回同一个 ID】——批次不重叠，后一批看不到前一批的标题块；它靠 sectionRelation=CONTINUATION 由后端机械继承前一批末章节来合并。批次边界的情况必须用 sectionRelation 显式表态，不能只给 null 让后端猜——null 至少压着五种互不相同的情况（承接上文 / 本就无章节 / 上一章已结束 / 标题被裁在切分线上 / 没识别出来），后端无差别继承等于又在替模型决定章节归属。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sectionName",
          "sectionIndex",
          "sectionRelation",
          "sectionBlockRef"
        ],
        "properties": {
          "sectionName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "章节标题原文，不改写。CURRENT：必须能在 sectionBlockRef 所指的块里逐字找到。UNSECTIONED：本字段会上分组标题，同样要有来源——必须能在【该组覆盖的全部块的合并文本】里逐字找到（封面上真印着「检查须知」就留得住，模型自己概括的「其他内容」留不住，降为固定文案）。CONTINUATION：给被承接章节的同名标题。UNKNOWN：后端不采信本字段、一律固定文案。任何一态都不许编造看起来像报告原文的标题。"
          },
          "sectionIndex": {
            "$ref": "#/$defs/sectionIndex"
          },
          "sectionRelation": {
            "type": "string",
            "enum": [
              "CURRENT",
              "CONTINUATION",
              "UNSECTIONED",
              "UNKNOWN"
            ],
            "description": "CURRENT=标题就在本批内；CONTINUATION=承接上一批未结束的章节（跨页续表）；UNSECTIONED=这部分内容本就不属于任何章节（封面、须知、附录、页末声明）；UNKNOWN=没看清或不确定。后端【只在 CONTINUATION 时继承】上一批末章节；UNSECTIONED/UNKNOWN 单独成组，不并入任何章节。拿不准一律 UNKNOWN——不归组是安全的，误报 CONTINUATION 会把封面文字挂到检查章节下。"
          },
          "sectionBlockRef": {
            "oneOf": [
              {
                "$ref": "#/$defs/blockRef"
              },
              {
                "type": "null"
              }
            ],
            "description": "印着该章节标题的块（批内块号）。sectionRelation=CURRENT 时必填；另外三态必须为 null。"
          }
        }
      }
    },
    "allergenSectionBlockRefs": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/blockRef"
      },
      "description": "过敏筛查章节的【全部】块，包括未能抽出条目的数据行。这是过敏漏抽覆盖检查的输入，漏圈等于关掉最后一道防线。无过敏章节时为空数组。"
    },
    "allergenDataBlockRefs": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/blockRef"
      },
      "description": "allergenSectionSegmentIds 的子集：其中【确认读到了过敏原检测数据行】的那些段。标题行、表头行、空行不进本数组；读到了但看不懂结果的行要进（对应条目 resultStatus=UNKNOWN）。Java 靠它区分「读全了全是阴性」和「一行都没读出来」——缺它会把最常见的全阴性面板误判成漏抽。"
    }
  },
  "$defs": {
    "blockRef": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4095,
      "description": "【批内块号】，不是 segmentId。输入里每个文本块前面标着 [n]，n 从 0 起、按块的自然顺序连续编号，模型只能原样回填。后端拿它查本批的映射表展开成 segmentId。上界 4095 = 400 块/页 × 8 页 + 余量；超界说明解析阶段的密度闸没生效。"
    },
    "fileIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "conclusionBasis": {
      "type": "string",
      "enum": [
        "REPORT_TEXT",
        "REFERENCE_RANGE_IN_RANGE",
        "REFERENCE_VALUE_MATCH"
      ],
      "description": "该指标的结论从哪来。REPORT_TEXT=报告印了结论原文，conclusionText 非空；REFERENCE_RANGE_IN_RANGE=报告只印了数值结果与参考范围，由模型拆出上下界、Java 比较后确认落在范围内；REFERENCE_VALUE_MATCH=报告只印了定性结果与定性参考值，由模型归一化后 Java 做精确 equals 确认一致。【后两态只表示「符合本报告给出的参考值」，不是对身体状况的判断】，也【只准入相符的情况】：不符而报告没给结论的一律不展示，系统不得凭空生成异常结论。"
    },
    "rangeComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measuredValue",
        "lowerBound",
        "lowerInclusive",
        "upperBound",
        "upperInclusive"
      ],
      "description": "已拆解为十进制的比较条件。四个数值字段一律用字符串承载，避免 JSON 浮点在边界值上失真；Java 侧用 BigDecimal 解析并只做 compareTo。",
      "properties": {
        "measuredValue": {
          "$ref": "#/$defs/decimalString",
          "description": "检查结果的十进制形式，必须与 value 字段数值相等（Java 用 BigDecimal.compareTo 核验，允许 6.2 与 6.20 这类标度差异）。"
        },
        "lowerBound": {
          "oneOf": [
            {
              "$ref": "#/$defs/decimalString"
            },
            {
              "type": "null"
            }
          ],
          "description": "下界；单边区间（如 <3.0）时为 null。【必须与 refRange 原文写着的区间完全一致】：报一个原文没有的下界、或把原文印着的下界省略成 null，都会让整条被丢弃。"
        },
        "lowerInclusive": {
          "type": "boolean",
          "description": "下界是否闭合：a~b 为 true，>a 为 false。lowerBound 为 null 时本字段无意义，固定 false。"
        },
        "upperBound": {
          "oneOf": [
            {
              "$ref": "#/$defs/decimalString"
            },
            {
              "type": "null"
            }
          ],
          "description": "上界；单边区间（如 >1.0）时为 null。约束与 lowerBound 对称，开闭标志同样参与核验：原文是 <3.0 就不许报成闭区间。"
        },
        "upperInclusive": {
          "type": "boolean",
          "description": "上界是否闭合：a~b 为 true，<b 为 false。upperBound 为 null 时本字段无意义，固定 false。"
        }
      }
    },
    "valueMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultComparableValue",
        "acceptableReferenceValues"
      ],
      "description": "已归一化的定性结果，以及参考值允许的全部取值。Java 只做集合包含判断，不做任何字面或同义词推理——「阴性」与「未检出」是否等价、「阴性或弱」到底允许哪几种，都属于语义归一化，必须在这里就展开成明确的枚举集合。",
      "properties": {
        "resultComparableValue": {
          "$ref": "#/$defs/comparableQualitativeValue"
        },
        "acceptableReferenceValues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/comparableQualitativeValue"
          },
          "description": "参考值允许的全部取值，【展开成列表而不是一个值】。报告的定性参考值常常不是单值：「阴性或弱」允许阴性与弱阳性两种。\n\n【不要让后端去做子串匹配】：「阳性」是「弱阳性」的子串，字面包含会把阳性结果判成符合参考值——那正是最危险的错法。展开成集合之后，后端只做 contains，不存在这类误判。"
        }
      }
    },
    "comparableQualitativeValue": {
      "type": "string",
      "enum": [
        "NEGATIVE",
        "POSITIVE",
        "WEAK_POSITIVE",
        "NOT_DETECTED"
      ],
      "description": "定性值的归一化枚举。【刻意只收这四个】：多一个词条就多一次医学等价判断，而等价关系（如「阴性」是否等于「未检出」）需要医学评审。归不进这四个的一律给 valueMatch=null，该指标不展示——不猜。",
      "$comment": "新增枚举值须走医学评审，理由同 constants 包下的内容常量。"
    },
