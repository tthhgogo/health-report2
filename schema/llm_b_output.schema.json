{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-report/schema/llm_b_output.schema.json",
  "title": "LLM-B 菜品维度打标输出（紧凑格式）",
  "description": "对应开发方案 §9.4。一次调用处理一个 enumKey × 一批菜品（≤40 道）。只用于食入性过敏原与饮食注意两类维度共 20 个，且当前【只判 REJECT】；营养补充 9 个维度由 Java 确定性交集匹配，不调本模型。NEUTRAL 菜品只回 ID 不回完整对象，但 neutralDishIds ∪ hitList 必须精确等于本批全部输入 dishId——覆盖范围不缩小，只是表达更紧凑。 本 Schema 由 constants/ 下的 registry 生成，禁止手写。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enumKey",
    "neutralDishIds",
    "hitList"
  ],
  "properties": {
    "enumKey": {
      "type": "string",
      "description": "本批打标维度，必须与请求一致",
      "enum": [
        "SHRIMP_CRAB",
        "FISH",
        "MILK",
        "EGG",
        "PEANUT",
        "SOY",
        "WHEAT",
        "NUTS",
        "MANGO",
        "BEEF",
        "MUTTON",
        "LOW_FAT",
        "LOW_SODIUM",
        "LOW_ADDED_SUGAR",
        "LOW_PURINE",
        "LOW_CHOLESTEROL",
        "LOW_CALORIE",
        "HIGH_FIBER",
        "LIMIT_ALCOHOL",
        "LIGHT_DIET"
      ]
    },
    "neutralDishIds": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "description": "已核验且结论为 NEUTRAL 的菜品 ID。不得包含未核验的菜——漏返回的菜由 Java 判为整批无效，不会被静默补成 NEUTRAL。"
    },
    "hitList": {
      "type": "array",
      "maxItems": 40,
      "description": "只放 REJECT 的菜品。NEUTRAL 进 neutralDishIds。当前无任何维度产生 RECOMMEND，见 verdict 说明。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dishId",
          "verdict",
          "evidenceType",
          "matchedIngredients",
          "reason"
        ],
        "properties": {
          "dishId": {
            "type": "integer",
            "minimum": 1
          },
          "verdict": {
            "type": "string",
            "enum": [
              "REJECT"
            ],
            "description": "当前 registry 中 20 个 LLM-B 维度【一条 verdictEffect=RECOMMEND 的规则都没有】——51 条推荐规则全在营养维度，而营养由 Java 确定性交集计算。因此本字段由 registry 生成为 REJECT-only。若将来 registry 新增饮食注意的 RECOMMEND 规则，本枚举随生成器自动放开。"
          },
          "evidenceType": {
            "type": "string",
            "enum": [
              "INGREDIENT",
              "DISH_NAME",
              "COOKING"
            ],
            "description": "INGREDIENT 要求 matchedIngredients 非空且属于该菜食材表；DISH_NAME/COOKING 允许为空但 reason 必须非空。"
          },
          "matchedIngredients": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "reason": {
            "type": "string",
            "maxLength": 128,
            "description": "仅供排障与人工抽查，不直接展示给用户；展示文案由 Java 拼接（§8.11）"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "evidenceType": {
                  "const": "INGREDIENT"
                }
              },
              "required": [
                "evidenceType"
              ]
            },
            "then": {
              "properties": {
                "matchedIngredients": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "evidenceType": {
                  "enum": [
                    "DISH_NAME",
                    "COOKING"
                  ]
                }
              },
              "required": [
                "evidenceType"
              ]
            },
            "then": {
              "properties": {
                "reason": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": []
}