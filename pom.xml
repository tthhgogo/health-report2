<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 的依赖托管来自 parent 继承，不是来自 spring-boot.version 属性。
         没有这段，后续写 starter / MySQL 驱动 / Jackson 时会缺 version 直接构建失败
         （开发方案 §1.1）。 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>org.example</groupId>
    <artifactId>health-report2</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 版本必须钉死，不能用范围，否则不同开发拿到的依赖树不同（开发方案 §1.1） -->
        <lombok.version>1.18.42</lombok.version>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <mysql-connector.version>8.0.33</mysql-connector.version>
        <pdfbox.version>2.0.30</pdfbox.version>
        <ofdrw.version>2.4.0</ofdrw.version>
        <tinypinyin.version>2.0.3</tinypinyin.version>
        <json-schema-validator.version>1.0.87</json-schema-validator.version>
        <swagger-annotations.version>1.6.2</swagger-annotations.version>
        <embedded-redis.version>1.4.3</embedded-redis.version>
        <xxl-job.version>2.4.1</xxl-job.version>
        <archunit.version>1.0.1</archunit.version>
        <wiremock.version>2.35.1</wiremock.version>
        <poi.version>5.2.5</poi.version>
        <docx4j.version>8.3.15</docx4j.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql-connector.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ofdrw</groupId>
            <artifactId>ofdrw-reader</artifactId>
            <version>${ofdrw.version}</version>
        </dependency>
        <dependency>
            <!-- OFD 逐页转图（ImageMaker）；与 ofdrw-reader 同族同版本，Word 删除后 OFD 是唯一新增渲染路径 -->
            <groupId>org.ofdrw</groupId>
            <artifactId>ofdrw-converter</artifactId>
            <version>${ofdrw.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.promeg</groupId>
            <artifactId>tinypinyin</artifactId>
            <version>${tinypinyin.version}</version>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
        </dependency>
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
            <version>${xxl-job.version}</version>
        </dependency>
        <!-- 仅接口文档注解（@Api/@ApiModel 等，AGENTS.md §6）；不引入 springfox/knife4j 文档 UI，由部署侧决定 -->
        <dependency>
            <groupId>io.swagger</groupId>
            <artifactId>swagger-annotations</artifactId>
            <version>${swagger-annotations.version}</version>
        </dependency>
        <!-- 常量类的 @Getter；provided 作用域，不进运行时依赖 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit4</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- 嵌入式 Redis：跑真实 redis-server 进程验证 TTL、键名与序列化往返。
             选它而不是 Testcontainers，是因为构建机不保证有 Docker；
             按开发方案任务 03 §6「嵌入式或 Testcontainers 二选一并说明」记录本选择。 -->
        <dependency>
            <groupId>com.github.codemonstur</groupId>
            <artifactId>embedded-redis</artifactId>
            <version>${embedded-redis.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.tomakehurst</groupId>
            <artifactId>wiremock-jre8</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- DOCX 文本抽取路线评估实验（设计方案 §12-16 相关）；仅测试作用域，不进生产依赖。
             结论落定后若不立项，连同实验测试一起移除。 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- 老版二进制 DOC 转图路线评估实验（POI HWPF → WordToFoConverter → FOP）；
             仅测试作用域。FOP 由 docx4j-export-fo 传递提供，评估结论落定前不进生产依赖。 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-scratchpad</artifactId>
            <version>${poi.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- DOCX 排版转 PDF（设计方案 §3.2.1，2026-09-05 恢复 DOCX 支持）：
             docx4j → XSL-FO/FOP 是唯一不依赖 LibreOffice/商业库/Office 本体的纯 Java 转图路线，
             真实样本评估通过后由 test 转为生产作用域；产出 PDF 复用既有 pdfbox 渲染路径。
             8.x 是 Java 8 兼容线；保真依赖部署镜像的 CJK 字体（DocxToPdfConverter 候选表）。 -->
        <dependency>
            <groupId>org.docx4j</groupId>
            <artifactId>docx4j-JAXB-ReferenceImpl</artifactId>
            <version>${docx4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.docx4j</groupId>
            <artifactId>docx4j-export-fo</artifactId>
            <version>${docx4j.version}</version>
        </dependency>
    </dependencies>

    <!-- com.github.promeg:tinypinyin:2.0.3 未发布到 Maven Central；
         仅启用发布版本，禁用快照，避免引入不稳定构件。 -->
    <repositories>
        <repository>
            <id>aliyun-public</id>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>prompt</directory>
                <targetPath>prompt</targetPath>
                <includes>
                    <include>*.md</include>
                    <include>versions.tsv</include>
                </includes>
            </resource>
            <resource>
                <directory>schema</directory>
                <targetPath>schema</targetPath>
                <includes>
                    <include>indicators.schema.json</include>
                    <include>health_problems.schema.json</include>
                    <include>diet_advice.schema.json</include>
                    <include>dish_tag_output.schema.json</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                    <encoding>UTF-8</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 性能与真实模型能力探针必须显式选择，普通单测不得误报为已执行。 -->
                    <excludedGroups>pre-release-only,image-probe</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>pre-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>release-gate</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- LLM-A 纯图像输入探针：连真实网关，必须显式选择才跑。 -->
            <id>image-probe</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>image-probe</groups>
                            <excludedGroups>none</excludedGroups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
